{
  "name": "docscribe-vscode",
  "displayName": "DocScribe",
  "description": "%extension.description%",
  "version": "0.1.3",
  "publisher": "unurgunite",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/FlorexLabs/docscribe-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/FlorexLabs/docscribe-vscode/issues"
  },
  "homepage": "https://github.com/FlorexLabs/docscribe-vscode#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "ruby",
    "yard",
    "documentation",
    "docscribe"
  ],
  "activationEvents": [
    "onLanguage:ruby",
    "onLanguage:rake",
    "workspaceContains:**/Gemfile"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "docscribe.checkFile",
        "title": "%command.checkFile%"
      },
      {
        "command": "docscribe.checkWorkspace",
        "title": "%command.checkWorkspace%"
      },
      {
        "command": "docscribe.safeFix",
        "title": "%command.safeFix%"
      },
      {
        "command": "docscribe.aggressiveFix",
        "title": "%command.aggressiveFix%"
      },
      {
        "command": "docscribe.applyFix",
        "title": "%command.applyFix%"
      },
      {
        "command": "docscribe.toggleFoldComments",
        "title": "%command.toggleFoldComments%"
      },
      {
        "command": "docscribe.updateTypes",
        "title": "%command.updateTypes%"
      },
      {
        "command": "docscribe.doctor",
        "title": "%command.doctor%"
      }
    ],
    "keybindings": [
      {
        "command": "docscribe.checkFile",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "editorLangId == ruby"
      },
      {
        "command": "docscribe.checkWorkspace",
        "key": "ctrl+shift+d w",
        "mac": "cmd+shift+d w",
        "when": "editorLangId == ruby"
      },
      {
        "command": "docscribe.safeFix",
        "key": "ctrl+shift+d s",
        "mac": "cmd+shift+d s",
        "when": "editorLangId == ruby"
      },
      {
        "command": "docscribe.aggressiveFix",
        "key": "ctrl+shift+d a",
        "mac": "cmd+shift+d a",
        "when": "editorLangId == ruby"
      },
      {
        "command": "docscribe.updateTypes",
        "key": "ctrl+shift+d u",
        "mac": "cmd+shift+d u",
        "when": "editorLangId == ruby"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "docscribe.checkFile",
          "when": "editorLangId == ruby",
          "group": "navigation@1"
        },
        {
          "command": "docscribe.safeFix",
          "when": "editorLangId == ruby",
          "group": "1_modification@1"
        },
        {
          "command": "docscribe.aggressiveFix",
          "when": "editorLangId == ruby",
          "group": "1_modification@2"
        },
        {
          "command": "docscribe.updateTypes",
          "when": "editorLangId == ruby",
          "group": "1_modification@3"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "docscribe_check_file",
        "displayName": "%lm.checkFile.displayName%",
        "modelDescription": "%lm.checkFile.description%",
        "inputSchema": {
          "type": "object",
          "properties": {
            "filePath": {
              "type": "string",
              "description": "Absolute path to the Ruby file to check"
            }
          },
          "required": [
            "filePath"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "docscribe_check_workspace",
        "displayName": "%lm.checkWorkspace.displayName%",
        "modelDescription": "%lm.checkWorkspace.description%",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      {
        "name": "docscribe_safe_fix",
        "displayName": "%lm.safeFix.displayName%",
        "modelDescription": "%lm.safeFix.description%",
        "inputSchema": {
          "type": "object",
          "properties": {
            "filePath": {
              "type": "string",
              "description": "Absolute path to the Ruby file to fix"
            }
          },
          "required": [
            "filePath"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "docscribe_aggressive_fix",
        "displayName": "%lm.aggressiveFix.displayName%",
        "modelDescription": "%lm.aggressiveFix.description%",
        "inputSchema": {
          "type": "object",
          "properties": {
            "filePath": {
              "type": "string",
              "description": "Absolute path to the Ruby file to fix"
            }
          },
          "required": [
            "filePath"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "docscribe_update_types",
        "displayName": "%lm.updateTypes.displayName%",
        "modelDescription": "%lm.updateTypes.description%",
        "inputSchema": {
          "type": "object",
          "properties": {
            "filePath": {
              "type": "string",
              "description": "Absolute path to the Ruby file to update types for"
            }
          },
          "required": [
            "filePath"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "docscribe_doctor",
        "displayName": "%lm.doctor.displayName%",
        "modelDescription": "%lm.doctor.description%",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      }
    ],
    "configuration": {
      "title": "DocScribe",
      "properties": {
        "docscribe.commandPath": {
          "type": "string",
          "default": "docscribe",
          "description": "%config.commandPath%"
        },
        "docscribe.useBundleExec": {
          "type": "boolean",
          "default": true,
          "description": "%config.useBundleExec%"
        },
        "docscribe.runOnSave": {
          "type": "boolean",
          "default": true,
          "description": "%config.runOnSave%"
        },
        "docscribe.useRbs": {
          "type": "boolean",
          "default": true,
          "description": "%config.useRbs%"
        },
        "docscribe.validateTypes": {
          "type": "boolean",
          "default": true,
          "description": "%config.validateTypes%"
        },
        "docscribe.ignorePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.ignorePatterns%"
        },
        "docscribe.foldComments": {
          "type": "boolean",
          "default": false,
          "description": "%config.foldComments%"
        },
        "docscribe.omitBoilerplate": {
          "type": "boolean",
          "default": false,
          "description": "%config.omitBoilerplate%"
        },
        "docscribe.rubyPath": {
          "type": "string",
          "default": "ruby",
          "description": "%config.rubyPath%"
        },
        "docscribe.bundlePath": {
          "type": "string",
          "default": "bundle",
          "description": "%config.bundlePath%"
        },
        "docscribe.useServer": {
          "type": "boolean",
          "default": true,
          "description": "%config.useServer%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/sinon": "^21.0.1",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "mocha": "^11.7.6",
    "mock-fs": "^5.5.0",
    "prettier": "^3.8.4",
    "sinon": "^22.0.0",
    "typedoc": "^0.28.19",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "minimatch": "^10.2.5"
  }
}
